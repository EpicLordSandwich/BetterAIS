{
  "manifest_version": 3,
  "name": "betterAIS",
  "version": "1.3.4",
  "description": "Vlastný vzhľad pre is.stuba.sk – témy, tmavý režim, CSS snippety, paleta príkazov Ctrl+K, table-tools, profilovka, odkazy, náhľad pošty a rozvrhu.",
  "browser_specific_settings": {
    "gecko": {
      "id": "betterais-extension@github.com",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "background": {
    "scripts": [
      "themes.js",
      "text-utils.js",
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "betterAIS",
    "default_icon": {
      "16": "icon128.png",
      "32": "icon128.png",
      "48": "icon128.png",
      "128": "icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icon128.png",
    "32": "icon128.png",
    "48": "icon128.png",
    "128": "icon128.png"
  },
  "commands": {
    "dump": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "betterAIS – diagnostika stránky (kopíruje štruktúru)"
    },
    "pick": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "betterAIS – vybrať prvok na stránke"
    },
    "toggle-mode": {
      "suggested_key": {
        "default": "Ctrl+Shift+M",
        "mac": "Command+Shift+M"
      },
      "description": "betterAIS – prepnúť tmavý/svetlý režim"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://is.stuba.sk/*"
      ],
      "css": [
        "base.css"
      ],
      "js": [
        "themes.js",
        "text-utils.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "ais-logo.png"
      ],
      "matches": [
        "https://is.stuba.sk/*"
      ]
    }
  ]
}
